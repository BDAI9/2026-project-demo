# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# 잇플(BC카드) 직접 제휴 API: 발급받은 기관명. 비우면 가상 샘플 가게로 동작합니다.
# 서버를 실행하는 컴퓨터의 공인 IP가 잇플에 등록돼 있어야 합니다.
EATPL_INSTITUTION=
# prod면 운영 서버, 비우면 개발 서버(dev-api.paybooc.ai)
EATPL_ENV=

# OpenRouter: 가게별 가격대·분위기·알레르기 위험 AI 추정. 비우면 업종 정보로만 추천합니다.
OPENROUTER_API_KEY=
# 쉼표로 여러 모델을 적으면 앞에서부터 순서대로 시도 (비우면 기본 무료 모델 3개)
OPENROUTER_MODEL=
