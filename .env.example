# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.
OPENROUTER_API_KEY=
# 쉼표로 여러 모델을 적으면 앞에서부터 순서대로 시도합니다 (비워두면 기본 무료 모델 3개)
OPENROUTER_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
# 1이면 통합 화면(python -m backend.server)에서도 AI 해석을 사용합니다. 비우면 규칙 기반만 사용
CONDITION_AI_USE_LLM=
